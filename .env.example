# Database Configuration
# For Docker: use 'postgres' as hostname (docker-compose service name)
# For localhost: use 'localhost' or '127.0.0.1'
DATABASE_URL=postgresql://vibehack:vibehack_pass@postgres:5432/vibehack
# DATABASE_URL=postgresql://vibehack:vibehack_pass@localhost:5432/vibehack

# Ollama Configuration
# For Docker: use 'ollama' as hostname (docker-compose service name)
# For localhost: use 'localhost' or '127.0.0.1'
OLLAMA_BASE_URL=http://ollama:11434
# OLLAMA_BASE_URL=http://localhost:11434
